@startuml
' Убираем тени, чтобы выглядело более строго, как на фото
skinparam shadowing false
' Настраиваем шрифт (опционально, для лучшего соответствия)
skinparam defaultFontName Arial

' Сущность: Читатель
entity "Читатель" as Reader {
  *ID : PK
  --
  Имя
  Фамилия
  Адрес
  Дата рождения
}

' Сущность: Бронирование
entity "Бронирование" as Booking {
  --
  Дата выдачи
  План. дата возврата
  Факт. дата возврата
}

' Сущность: Экземпляр
entity "Экземпляр" as Copy {
  *Номер.копии : PK
  --
  Положение на полке
}

' Сущность: Издательство
entity "Издательство" as Publisher {
  *Название : PK
  --
  Адрес
}

' Сущность: Категория
entity "Категория" as Category {
  *Название : PK
}

' Сущность: Книга
entity "Книга" as Book {
  *ISBN : PK
  --
  Название
  Автор
  Год издания
  Количество страниц
}

' --- Связи (Relationships) ---

' Читатель (1) --- (0..*) Бронирование
Reader ||--o{ Booking

' Бронирование (0..*) --- (1) Экземпляр
Booking }o--|| Copy

' Издательство (1) --- (0..*) Книга
Publisher ||--o{ Book

' Категория (1) --- (0..*) Книга
Category ||--o{ Book

' Экземпляр (0..*) --- (1) Книга
Copy }o--|| Book

' Рекурсивная связь у Категории (подкатегории)
Category ||--o{ Category

@enduml
